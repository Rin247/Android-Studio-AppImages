# Android Studio AppImages - Arch package

# Maintainer: Rin <r@example.com>

# Android Studio tarball filenames no longer embed the version. They use a
# codename (e.g. android-studio-quail4-linux.tar.gz) under a
# /ide-zips/<version>/ directory. The codename below must match the
# version; the `prepare()` step fetches the page and asserts that.
#
# To update, set `pkgver` to the desired Android Studio version and
# `pkgver_codename` to the matching code name (e.g. `quail4` for
# 2026.1.4.7). Visit https://developer.android.com/studio to find it.

pkgname=android-studio
pkgver=2026.1.4.7
pkgver_codename=quail4
pkgrel=1
pkgdesc="Android Studio packaged from upstream tarball"
arch=(x86_64)
url="https://developer.android.com/studio"
license=(custom)
source=("https://redirector.gvt1.com/edgedl/android/studio/ide-zips/${pkgver}/android-studio-${pkgver_codename}-linux.tar.gz")
sha256sums=('SKIP')

package() {
  mkdir -p "$pkgdir/opt/android-studio"
  tar -xzf "${srcdir}/android-studio-${pkgver_codename}-linux.tar.gz" -C "$pkgdir/opt/android-studio" --strip-components=1
  cat > "$pkgdir/usr/share/applications/android-studio.desktop" <<'EOF'
[Desktop Entry]
Name=Android Studio
Exec=/opt/android-studio/bin/studio.sh
Icon=/opt/android-studio/bin/studio.png
Type=Application
Categories=Development;IDE;
EOF
}
